{
  // Default layout: item panels on the LEFT, map fills the rest on the right
  "tracker_default": {
    "type": "container",
    "background": "#20201f",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "left",
          "content": [
            {
              "type": "group",
              "header": "Options",
              "dock": "top",
              "content": { "type": "layout", "key": "settings_grid" }
            },
            {
              "type": "array",
              "orientation": "horizontal",
              "content": [
                { "type": "group", "header": "Chapters",        "content": { "type": "layout", "key": "chapters_grid" } },
                { "type": "group", "header": "Key Items",       "content": { "type": "layout", "key": "key_items_grid" } },
                { "type": "group", "header": "Weapons",         "content": { "type": "layout", "key": "weapons_grid" } },
                { "type": "group", "header": "Weapon Upgrades", "content": { "type": "layout", "key": "weapons_upgrades_grid" } }
              ]
            }
          ]
        },
        {
          "type": "layout",
          "key": "chapters",
          "h_alignment": "stretch",
          "v_alignment": "stretch"
        }
      ]
    }
  },
  // PopTracker auto-selects the root layout by window aspect ratio:
  //   width/height > 1 -> "tracker_horizontal", < 1 -> "tracker_vertical", == 1 -> "tracker_default".
  // We want items-left / map-right in every case, so tracker_horizontal mirrors tracker_default.
  // (tracker_vertical is intentionally omitted; PopTracker falls back to tracker_default.)
  "tracker_horizontal": {
    "type": "container",
    "background": "#20201f",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "left",
          "content": [
            {
              "type": "group",
              "header": "Options",
              "dock": "top",
              "content": { "type": "layout", "key": "settings_grid" }
            },
            {
              "type": "array",
              "orientation": "horizontal",
              "content": [
                { "type": "group", "header": "Chapters",        "content": { "type": "layout", "key": "chapters_grid" } },
                { "type": "group", "header": "Key Items",       "content": { "type": "layout", "key": "key_items_grid" } },
                { "type": "group", "header": "Weapons",         "content": { "type": "layout", "key": "weapons_grid" } },
                { "type": "group", "header": "Weapon Upgrades", "content": { "type": "layout", "key": "weapons_upgrades_grid" } }
              ]
            }
          ]
        },
        {
          "type": "layout",
          "key": "chapters",
          "h_alignment": "stretch",
          "v_alignment": "stretch"
        }
      ]
    }
  }
}
